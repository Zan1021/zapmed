APP_NAME=Zapmed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=zapmed
# DB_USERNAME=forge
# DB_PASSWORD=

# Cache & Sessions
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Redis (for staging/production)
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail (Brevo SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@zapmed.co.za
MAIL_FROM_NAME="${APP_NAME}"

# PayFast (Sandbox)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_TEST_MODE=true

# Multi-Country
APP_COUNTRY=za

# OpenAI (AI prescription suggestions)
OPENAI_API_KEY=

# Daily.co (Video Calls)
DAILY_API_KEY=
DAILY_DOMAIN=

# BulkSMS (OTP for 2FA)
SMS_API_TOKEN=

# Vite
VITE_APP_NAME="${APP_NAME}"

# Google Analytics (add your GA4 Measurement ID when ready)
GOOGLE_ANALYTICS_ID=
# Google Analytics Data API (for admin dashboard — service account JSON path)
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Google Places (for pulling Google Reviews)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# PageSpeed Insights API Key (free from Google Cloud Console)
PAGESPEED_API_KEY=


# Sentry Error Tracking
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
