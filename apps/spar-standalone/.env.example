APP_NAME="SPAR Meds"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local/dev: sqlite. Staging/prod: pgsql (Postgres 16) — set in Forge env.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=spar_standalone
# DB_USERNAME=forge
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@sparmeds.test"
MAIL_FROM_NAME="${APP_NAME}"

# SPAR standalone deployment
SPAR_HOST_MODE=standalone
SPAR_ONBOARDING_MODE=pharmacist_capture

# National patient identity — keyed hash (blind index) of the encrypted profile
# code + phone, so a patient is matched ACROSS stores without decrypting (POPIA).
# Set a dedicated random value per environment: php artisan key:generate --show
# then paste it here. Back it up — losing it means re-running
# `php artisan spar:backfill-blind-index` to recompute hashes. If left blank the
# app falls back to APP_KEY (fine for local/dev, NOT recommended for production).
SPAR_BLIND_INDEX_KEY=

SPAR_BRAND_NAME="SPAR Pharmacy"
SPAR_BRAND_COLOR="#006B3F"
SPAR_CHANNELS=inapp,email,sms
SPAR_LINK_REQUIRE_OTP=true

# WhatsApp (Meta Cloud API direct — Phase 6). Driver defaults to 'log' (no creds,
# records what it would send) so the flow is testable before a WABA exists.
# Flip to cloud_api + fill creds once Meta onboarding is done. To make WhatsApp
# primary: SPAR_CHANNELS=inapp,whatsapp,email,sms (SMS stays as fallback).
SPAR_WHATSAPP_ENABLED=false
SPAR_WHATSAPP_DRIVER=log
# SPAR_WHATSAPP_PHONE_NUMBER_ID=
# SPAR_WHATSAPP_TOKEN=
# SPAR_WA_TPL_ONBOARDING=
# SPAR_WA_TPL_MONTHLY=
# SPAR_WA_TPL_RENEWAL=
# SPAR_WA_TPL_MISSED=
