# =============================================================================
# SPAR Standalone — PRODUCTION / STAGING env template (Forge)
# =============================================================================
# Paste into Forge → Site → Environment, then fill the <PLACEHOLDERS>.
# Keep Forge's generated APP_KEY and the DB password Forge shows you — do NOT
# overwrite them with these placeholders.
#
# Server: zapdev (Ten21 Media), 143.244.215.131. PostgreSQL 16. DNS: xneelo.
# NOTE: this is a SINGLE-domain app (NOT multi-tenant) — no wildcard needed
#       unless you later want tenant subdomains. Apex + www SSL is enough.
# =============================================================================

APP_NAME="SPAR Meds"
APP_ENV=staging
APP_KEY=                      # KEEP Forge's generated key
APP_DEBUG=false
APP_URL=https://<DOMAIN>      # e.g. https://sparmeds.co.za  (decide domain)
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database: PostgreSQL (Forge-created DB) ---------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=spar_standalone   # create this DB in Forge UI
DB_USERNAME=forge
DB_PASSWORD=                  # KEEP the password Forge generated for the DB

# --- Sessions: shared-safe, HTTPS-only ---------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.<DOMAIN>      # leading dot; e.g. .sparmeds.co.za
SESSION_SECURE_COOKIE=true    # requires SSL to be LIVE or logins break

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail: Brevo HTTP API (same provider as ZapMed) --------------------------
# If reusing ZapMed's Brevo account, pull the key from zapmed-services notes.
MAIL_MAILER=log               # switch to brevo once key is set
# MAIL_MAILER=brevo
# BREVO_API_KEY=<PLACEHOLDER>
MAIL_FROM_ADDRESS="noreply@<DOMAIN>"
MAIL_FROM_NAME="${APP_NAME}"

# --- SPAR standalone behaviour -----------------------------------------------
SPAR_HOST_MODE=standalone         # locks NullTelehealthBridge (no telehealth)
SPAR_ONBOARDING_MODE=pharmacist_capture   # Mode B for the pilot (sales extract)
# National patient identity — REQUIRED in production. Keyed hash (blind index)
# used to match patients across stores WITHOUT decrypting profile code / phone
# (POPIA). Generate a DEDICATED value (php artisan key:generate --show) — do NOT
# reuse APP_KEY. BACK IT UP: if lost, re-run `php artisan spar:backfill-blind-index`
# to recompute all hashes. After first deploy run the backfill, then
# `spar:merge-duplicates --dry-run` (review) before merging.
SPAR_BLIND_INDEX_KEY=<PLACEHOLDER — generate a dedicated random key>
SPAR_BRAND_NAME="SPAR Pharmacy"
SPAR_BRAND_COLOR="#006B3F"
SPAR_CHANNELS=inapp,email,sms     # WhatsApp deferred; SMS is fallback
SPAR_LINK_REQUIRE_OTP=true
SPAR_CONSENT_VERSION=1.0          # bump when compliance changes wording

# --- SMS provider (pilot: log-only until a provider is wired) ----------------
# StandaloneSmsChannel logs by default. When BulkSMS/other is provisioned,
# add its credentials here and implement the send in StandaloneSmsChannel.
# BULKSMS_TOKEN_ID=<PLACEHOLDER>
# BULKSMS_TOKEN_SECRET=<PLACEHOLDER>
